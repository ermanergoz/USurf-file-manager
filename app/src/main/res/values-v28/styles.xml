<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app bar's shadow in the platform's own black, which Material 3 makes transparent from Android 9 on. -->
    <style name="Widget.App.AppBarLayout" parent="Base.Widget.App.AppBarLayout">
        <item name="android:outlineAmbientShadowColor">@android:color/black</item>
        <item name="android:outlineSpotShadowColor">@android:color/black</item>
    </style>

    <!-- A section header is an accessibility heading from Android 9 on, as the Preferences category titles are. -->
    <style name="Widget.App.SectionHeader" parent="Base.Widget.App.SectionHeader">
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
