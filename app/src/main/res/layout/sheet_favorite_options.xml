<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/sheet_padding_vertical"
    android:paddingBottom="@dimen/sheet_padding_vertical">

    <TextView
        android:id="@+id/favoriteNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="@dimen/sheet_padding_vertical"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/sheet_padding_vertical"
        android:singleLine="true"
        android:textColor="@color/daynnightTextColor"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/openFavoriteRow"
        style="@style/SheetRow"
        app:drawableStartCompat="@drawable/ic_sheet_open"
        android:text="@string/open" />

    <TextView
        android:id="@+id/renameFavoriteRow"
        style="@style/SheetRow"
        app:drawableStartCompat="@drawable/ic_sheet_rename"
        android:text="@string/rename" />

    <TextView
        android:id="@+id/removeFavoriteRow"
        style="@style/SheetRow"
        app:drawableStartCompat="@drawable/ic_sheet_remove"
        android:text="@string/remove_favorite" />
</LinearLayout>
