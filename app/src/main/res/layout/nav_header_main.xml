<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_header_background"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingLeft="@dimen/drawer_header_padding"
    android:paddingTop="@dimen/drawer_header_padding"
    android:paddingRight="@dimen/drawer_header_padding"
    android:paddingBottom="@dimen/drawer_header_padding">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drawer_header_padding"
        android:contentDescription="@string/nav_header_desc"
        android:paddingTop="@dimen/item_gap"
        app:srcCompat="@mipmap/ic_launcher_round" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="@dimen/item_gap"
        android:text="@string/nav_header_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/onAppBar"
        android:textStyle="bold" />

</LinearLayout>