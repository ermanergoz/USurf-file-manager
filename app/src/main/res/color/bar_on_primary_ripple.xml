<?xml version="1.0" encoding="utf-8"?>
<!-- The press feedback of a button on a bar of the primary colour: a see-through layer of the colour drawn on that bar,
     so the label shows through it, at the strengths Material 3 gives a pressed, a focused and a hovered button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.10" android:color="?attr/colorOnPrimary" android:state_pressed="true" />
    <item android:alpha="0.10" android:color="?attr/colorOnPrimary" android:state_focused="true" />
    <item android:alpha="0.08" android:color="?attr/colorOnPrimary" android:state_hovered="true" />
    <item android:alpha="0.00" android:color="?attr/colorOnPrimary" />
</selector>
