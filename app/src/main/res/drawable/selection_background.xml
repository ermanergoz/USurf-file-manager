<?xml version="1.0" encoding="utf-8"?>
<!-- A selected list row: filled in the selection colour, rippling in the press colour like any row. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pressRipple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_small" />
            <solid android:color="@color/pressRipple" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_small" />
            <solid android:color="@color/selectionBackground" />
        </shape>
    </item>
</ripple>
